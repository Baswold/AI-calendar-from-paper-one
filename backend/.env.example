# ============================================================================
# Calendar Photo Converter - Environment Configuration
# ============================================================================
#
# This file contains environment variable configuration for the backend server.
# Copy this file to .env and fill in your actual values.
#
# ⚠️  SECURITY NOTE: Never commit .env files to version control!
#    The .gitignore file should already exclude .env files.
#
# ============================================================================

# ----------------------------------------------------------------------------
# Anthropic API Configuration (REQUIRED)
# ----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/account/keys
#
# This key is required for the AI-powered calendar image analysis.
# Without this key, the application will fall back to mock data.
#
# Example: ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxx
#
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ----------------------------------------------------------------------------
# Google OAuth Configuration (OPTIONAL)
# ----------------------------------------------------------------------------
# Required only if you want to enable Google Calendar integration.
# Get credentials from: https://console.cloud.google.com/apis/credentials
#
# Setup steps:
# 1. Create a new OAuth 2.0 Client ID
# 2. Set application type to "Web application"
# 3. Add authorized redirect URIs (see GOOGLE_REDIRECT_URI below)
# 4. Copy the Client ID and Client Secret here
#
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Redirect URI for OAuth callback
# Update this if you're running the server on a different port or domain
# Default for server.js: http://localhost:8000/auth-callback.html
# Default for api-server.js: http://localhost:9002/auth-callback.html
GOOGLE_REDIRECT_URI=http://localhost:8000/auth-callback.html

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------
# Port number for the server to listen on
#
# Default ports:
#   - server.js (full-featured) → 8000
#   - api-server.js (Claude API) → 9002
#
# Change this if the default port is already in use
# Valid range: 1-65535
#
PORT=8000

# ----------------------------------------------------------------------------
# Development & Debugging
# ----------------------------------------------------------------------------
# Enable detailed logging (true/false)
# DEBUG=false

# Maximum file upload size in MB (default: 10)
# MAX_UPLOAD_SIZE=10

# ----------------------------------------------------------------------------
# Production Settings (Optional)
# ----------------------------------------------------------------------------
# Set NODE_ENV to 'production' for production deployments
# NODE_ENV=production

# CORS allowed origins (comma-separated list)
# Leave empty to allow all origins (*)
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Session secret for secure sessions (generate a random string)
# SESSION_SECRET=your_random_session_secret_here